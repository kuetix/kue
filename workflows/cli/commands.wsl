const {
    commands: {
        "*": [{
            "*": {
                "options": [
                    {"long": "verbose", "short": "v", "value": false, "usage": "Verbose output", "type": "bool"},
                    {"long": "debug", "short": "vv", "value": false, "usage": "Debug output", "type": "bool"},
                    {"long": "quiet", "short": "q", "value": false, "usage": "Quiet mode", "type": "bool"},
                    {"long": "help", "short": "h", "value": false, "usage": "Help", "type": "bool"},
                    {"long": "modules", "short": "mp", "value": "modules", "usage": "Path to modules directory"},
                    {"long": "workflows", "short": "w", "value": "workflows", "usage": "Path to workflows directory"},
                ]
            }
        },],

        "help": [{
            "": {
                "workflow": "cli/help",
                "usage": "file://cli/usage/help.txt",
                "options": []
            }
            "examples": {
                "workflow": "cli/help",
                "usage": "file://cli/usage/help/examples.txt",
                "options": []
            }
            "env": {
                "workflow": "cli/help",
                "usage": "file://cli/usage/help/env.txt",
                "options": []
            }
            "*": {
                "$extends": "",
            },
        },],

        // Auth commands
        "login": [{
            "": {
                "workflow": "cli/auth/login",
                "usage": "file://cli/usage/login.txt",
                "options": [
                    {"long": "host", "short": "H", "value": "", "usage": "API host (default: api.kuetix.com)"},
                    {"long": "config", "short": "c", "value": "", "usage": "Path to config file"},
                    {"long": "username", "short": "u", "value": "", "usage": "Username for login"},
                    {"long": "password", "short": "p", "value": "", "usage": "Password for login"},
                ]
            },
            "help": {
                "$extends": "",
                "workflow": "cli/help"
            },
        },],

        "logout": [{
            "": {
                "workflow": "cli/auth/logout",
                "usage": "file://cli/usage/logout.txt",
                "options": [
                    {"long": "config", "short": "c", "value": "", "usage": "Path to config file"},
                ]
            },
            "help": {
                "$extends": "",
                "workflow": "cli/help"
            }
        },],

        "register": [{
            "": {
                "workflow": "cli/auth/register",
                "usage": "file://cli/usage/register.txt",
                "options": [
                    {"long": "host", "short": "H", "value": "", "usage": "API host (default: api.kuetix.com)"},
                    {"long": "email", "short": "e", "value": "", "usage": "Email for registration (required)"},
                    {"long": "password", "short": "p", "value": "", "usage": "Password for registration (required)"},
                    {"long": "name", "short": "n", "value": "", "usage": "Display name (optional)"},
                    {"long": "username", "short": "u", "value": "", "usage": "Username (optional)"},
                ]
            },
            "help": {
                "$extends": "",
                "workflow": "cli/help"
            }
        },],

        "profile": [{
            "get": {
                "workflow": "cli/auth/profile_get",
                "usage": "file://cli/usage/profile/get.txt",
                "options": [
                    {"long": "host", "short": "H", "value": "", "usage": "API host (default: api.kuetix.com)"},
                    {"long": "config", "short": "c", "value": "", "usage": "Path to config file"},
                ]
            },
            "update": {
                "workflow": "cli/auth/profile_update",
                "usage": "file://cli/usage/profile/update.txt",
                "options": [
                    {"long": "host", "short": "H", "value": "", "usage": "API host (default: api.kuetix.com)"},
                    {"long": "config", "short": "c", "value": "", "usage": "Path to config file"},
                    {"long": "name", "short": "n", "value": "", "usage": "Display name"},
                    {"long": "username", "short": "u", "value": "", "usage": "Username"},
                ]
            },
            "help": {
                "$extends": "",
                "workflow": "cli/help"
            },
        },],

        "whoami": [{
            "": {
                "workflow": "cli/auth/whoami",
                "usage": "file://cli/usage/whoami.txt",
                "options": [
                    {"long": "host", "short": "H", "value": "", "usage": "API host (default: api.kuetix.com)"},
                    {"long": "config", "short": "c", "value": "", "usage": "Path to config file"},
                    {"long": "json", "short": "j", "value": false, "usage": "Machine-readable output", "type": "bool"},
                ]
            },
            "help": {
                "$extends": "",
                "workflow": "cli/help"
            },
        },],

        // Create command
        "create": [{
            "": {
                "workflow": "cli/create/create",
                "usage": "file://cli/usage/create.txt",
                "options": [
                    {"long": "name", "short": "n", "value": "", "usage": "Project name (required)"},
                    {"long": "app-type", "short": "a", "value": "cli", "usage": "Application type: cli, api, consumer, service, package, all"},
                    {"long": "output", "short": "o", "value": ".", "usage": "Output directory"},
                    {"long": "force", "short": "f", "value": false, "usage": "Force creation without confirmation", "type": "bool"},
                    {"long": "template-path", "short": "tp", "value": "", "usage": "Local templates directory (the folder containing templates/)"},
                    {"long": "template-url", "short": "tu", "value": "", "usage": "URL to fetch templates from"},
                    {"long": "template-git", "short": "tg", "value": "", "usage": "Git repository URL for templates"},
                    {"long": "template-version", "short": "tv", "value": "", "usage": "Template version (default: latest)"},
                ]
            },
            "help": {
                "$extends": "",
                "workflow": "cli/help"
            }
        },],

        // Add commands (subcommands)
        "add": [{
            "": {
                "workflow": "cli/help",
                "usage": "file://cli/usage/add.txt",
                "options": []
            },
            "help": {
                "$extends": "",
                "workflow": "cli/help"
            },
            "module": {
                "workflow": "cli/add/module",
                "usage": "file://cli/usage/add/module.txt",
                "options": [
                    {"long": "name", "short": "n", "value": "", "usage": "Module name"},
                    {"long": "output", "short": "o", "value": ".", "usage": "Output directory"},
                    {"long": "force", "short": "f", "value": false, "usage": "Force creation without confirmation", "type": "bool"},
                ]
            },
            "workflow": {
                "workflow": "cli/add/workflow",
                "usage": "file://cli/usage/add/workflow.txt",
                "options": [
                    {"long": "name", "short": "n", "value": "", "usage": "Workflow name (may be dir/name)"},
                    {"long": "output", "short": "o", "value": ".", "usage": "Output directory"},
                    {"long": "force", "short": "f", "value": false, "usage": "Force creation without confirmation", "type": "bool"},
                ]
            },
            "feature": {
                "workflow": "cli/add/feature",
                "usage": "file://cli/usage/add/feature.txt",
                "options": [
                    {"long": "name", "short": "n", "value": "", "usage": "Feature name"},
                    {"long": "output", "short": "o", "value": ".", "usage": "Output directory"},
                    {"long": "force", "short": "f", "value": false, "usage": "Force creation without confirmation", "type": "bool"},
                ]
            },
            "solution": {
                "workflow": "cli/add/solution",
                "usage": "file://cli/usage/add/solution.txt",
                "options": [
                    {"long": "name", "short": "n", "value": "", "usage": "Solution name"},
                    {"long": "output", "short": "o", "value": ".", "usage": "Output directory"},
                    {"long": "force", "short": "f", "value": false, "usage": "Force creation without confirmation", "type": "bool"},
                ]
            },
            "package": {
                "workflow": "cli/add/package",
                "usage": "file://cli/usage/add/package.txt",
                "options": [
                    {"long": "name", "short": "n", "value": "", "usage": "Package name (defaults to the output directory name)"},
                    {"long": "output", "short": "o", "value": ".", "usage": "Output directory"},
                    {"long": "force", "short": "f", "value": false, "usage": "Force creation without confirmation", "type": "bool"},
                ]
            },
            "transition": {
                "workflow": "cli/add/transition",
                "usage": "file://cli/usage/add/transition.txt",
                "options": [
                    {"long": "name", "short": "n", "value": "", "usage": "Transition name (e.g. moduleName/MethodName)"},
                    {"long": "module", "short": "m", "value": "", "usage": "Module name to add the transition to"},
                    {"long": "description", "short": "d", "value": "", "usage": "Method description comment"},
                    {"long": "output", "short": "o", "value": ".", "usage": "Output directory"},
                ]
            },
        },],

        // (`kue search` removed — workflow search is `kue wsl <query>`,
        //  package search is `kue package search <query>`.)

        // Install command — download a workflow or package and wire it into the local project
        "install": [{
            "": {
                "workflow": "cli/install/install",
                "usage": "file://cli/usage/install.txt",
                "options": [
                    {"long": "type", "short": "t", "value": "", "usage": "Asset type: workflow or package (auto-detected if empty)"},
                    {"long": "owner", "short": "O", "value": "", "usage": "Registry owner id (disambiguates a workflow name)"},
                    {"long": "output", "short": "o", "value": ".", "usage": "Project directory (default: .)"},
                    {"long": "force", "short": "f", "value": false, "usage": "Overwrite existing files without prompting", "type": "bool"},
                    {"long": "host", "short": "H", "value": "", "usage": "API host (default: api.kuetix.com)"},
                    {"long": "config", "short": "c", "value": "", "usage": "Path to config file"},
                ]
            },
            "*": {
                "$extends": "",
            }
            "help": {
                "$extends": "",
                "workflow": "cli/help"
            }
        },],

        // `kue i` — alias for `kue install`
        "i": [{
            "": {
                "workflow": "cli/install/install",
                "usage": "file://cli/usage/install.txt",
                "options": [
                    {"long": "type", "short": "t", "value": "", "usage": "Asset type: workflow or package (auto-detected if empty)"},
                    {"long": "owner", "short": "O", "value": "", "usage": "Registry owner id (disambiguates a workflow name)"},
                    {"long": "output", "short": "o", "value": ".", "usage": "Project directory (default: .)"},
                    {"long": "force", "short": "f", "value": false, "usage": "Overwrite existing files without prompting", "type": "bool"},
                    {"long": "host", "short": "H", "value": "", "usage": "API host (default: api.kuetix.com)"},
                    {"long": "config", "short": "c", "value": "", "usage": "Path to config file"},
                ]
            },
            "*": {
                "$extends": "",
            }
            "help": {
                "$extends": "",
                "workflow": "cli/help"
            }
        },],

        // Run — execute a workflow (local .wsl/.swsl file, a published
        // registry workflow, or — auto-detected — a project directory).
        "run": [{
            "": {
                "workflow": "cli/run/run",
                "usage": "file://cli/usage/run.txt",
                "options": [
                    {"long": "name", "short": "n", "value": "", "usage": "Workflow file, org/name, or project directory"},
                    {"long": "owner", "short": "O", "value": "", "usage": "Registry owner id (disambiguates a workflow name)"},
                    {"long": "json", "short": "j", "value": false, "usage": "Machine-readable result", "type": "bool"},
                    {"long": "check", "short": "C", "value": false, "usage": "Validate + report runnability, do not execute", "type": "bool"},
                    {"long": "force", "short": "f", "value": false, "usage": "Run even if some action modules are missing", "type": "bool"},
                    {"long": "no-cache", "short": "N", "value": false, "usage": "Bypass the ~/.kue workflow cache", "type": "bool"},
                    {"long": "app-type", "short": "a", "value": "", "usage": "Application type for a project dir: cli, api, consumer, service, package"},
                    {"long": "output", "short": "o", "value": ".", "usage": "Project directory"},
                    {"long": "host", "short": "H", "value": "", "usage": "API host (default: api.kuetix.com)"},
                    {"long": "config", "short": "c", "value": "", "usage": "Path to config file"},
                ]
            },
            "*": {
                "$extends": "",
            }
            "help": {
                "$extends": "",
                "workflow": "cli/help"
            }
        },],

        // `kue r` — alias for `kue run`
        "r": [{
            "": {
                "workflow": "cli/run/run",
                "usage": "file://cli/usage/run.txt",
                "options": [
                    {"long": "name", "short": "n", "value": "", "usage": "Workflow file, org/name, or project directory"},
                    {"long": "owner", "short": "O", "value": "", "usage": "Registry owner id (disambiguates a workflow name)"},
                    {"long": "json", "short": "j", "value": false, "usage": "Machine-readable result", "type": "bool"},
                    {"long": "check", "short": "C", "value": false, "usage": "Validate + report runnability, do not execute", "type": "bool"},
                    {"long": "force", "short": "f", "value": false, "usage": "Run even if some action modules are missing", "type": "bool"},
                    {"long": "no-cache", "short": "N", "value": false, "usage": "Bypass the ~/.kue workflow cache", "type": "bool"},
                    {"long": "app-type", "short": "a", "value": "", "usage": "Application type for a project dir: cli, api, consumer, service, package"},
                    {"long": "output", "short": "o", "value": ".", "usage": "Project directory"},
                    {"long": "host", "short": "H", "value": "", "usage": "API host (default: api.kuetix.com)"},
                    {"long": "config", "short": "c", "value": "", "usage": "Path to config file"},
                ]
            },
            "*": {
                "$extends": "",
            }
            "help": {
                "$extends": "",
                "workflow": "cli/help"
            }
        },],

        // Modules linked into this kue binary
        "modules": [{
            "": {
                "workflow": "cli/run/modules",
                "usage": "file://cli/usage/modules.txt",
                "options": [
                    {"long": "json", "short": "j", "value": false, "usage": "Machine-readable output", "type": "bool"},
                ]
            },
            "help": {
                "$extends": "",
                "workflow": "cli/help"
            }
        },],
        "m": [{
            "": {
                "workflow": "cli/run/modules",
                "usage": "file://cli/usage/modules.txt",
                "options": [
                    {"long": "json", "short": "j", "value": false, "usage": "Machine-readable output", "type": "bool"},
                ]
            },
            "help": {
                "$extends": "",
                "workflow": "cli/help"
            }
        },],

        // Every action method runnable in this kue binary
        "transitions": [{
            "": {
                "workflow": "cli/run/transitions",
                "usage": "file://cli/usage/transitions.txt",
                "options": [
                    {"long": "module", "short": "m", "value": "", "usage": "Filter by Go module or namespace/class substring"},
                    {"long": "json", "short": "j", "value": false, "usage": "Machine-readable output", "type": "bool"},
                ]
            },
            "help": {
                "$extends": "",
                "workflow": "cli/help"
            }
        },],
        "t": [{
            "": {
                "workflow": "cli/run/transitions",
                "usage": "file://cli/usage/transitions.txt",
                "options": [
                    {"long": "module", "short": "m", "value": "", "usage": "Filter by Go module or namespace/class substring"},
                    {"long": "json", "short": "j", "value": false, "usage": "Machine-readable output", "type": "bool"},
                ]
            },
            "help": {
                "$extends": "",
                "workflow": "cli/help"
            }
        },],

        "update": [{
            "": {
                "workflow": "cli/project/update",
                "usage": "file://cli/usage/update.txt",
                "options": [
                ]
            },
            "help": {
                "$extends": "",
                "workflow": "cli/help"
            }
        },],

        "show": [{
            "": {
                "workflow": "cli/project/show",
                "usage": "file://cli/usage/show.txt",
                "options": []
            },
            "help": {
                "$extends": "",
                "workflow": "cli/help"
            }
        },],

        // `kue wsl` — search the registry (`kue wsl <query>`). The management
        // subcommands (get, inspect, status, upload, list, delete) are also
        // top-level commands (`kue get`, `kue inspect`, …) — the "wsl." forms
        // here are kept as aliases and $extend the top-level definitions.
        "wsl": [{
            "": {
                "workflow": "cli/search/wsl",
                "usage": "file://cli/usage/wsl.txt",
                "options": [
                    {"long": "search", "short": "s", "value": "", "usage": "Search for this query, even when it collides with a subcommand name (e.g. `kue wsl --search get`); handy in scripts/CI"},
                    {"long": "limit", "short": "n", "value": 10, "usage": "Maximum number of results (default: 10)", "type": "int"},
                    {"long": "host", "short": "H", "value": "", "usage": "API host (default: api.kuetix.com)"},
                    {"long": "config", "short": "c", "value": "", "usage": "Path to config file"},
                ]
            },
            // A bare positional (`kue wsl auth`) resolves here — search.
            "*": {
                "$extends": "",
            },
            "help": {
                "$extends": "",
                "workflow": "cli/help"
            },
            // Aliases of the top-level commands — same workflow + options.
            "get": {
                "workflow": "cli/install/install",
                "usage": "file://cli/usage/get.txt",
                "options": [
                    {"long": "name", "short": "n", "value": "", "usage": "Workflow (or package) name or glob"},
                    {"long": "type", "short": "t", "value": "", "usage": "Asset type: workflow or package (auto-detected if empty)"},
                    {"long": "owner", "short": "O", "value": "", "usage": "Registry owner id (disambiguates a workflow name)"},
                    {"long": "output", "short": "o", "value": ".", "usage": "Project directory (default: .)"},
                    {"long": "force", "short": "f", "value": false, "usage": "Overwrite local edits without prompting", "type": "bool"},
                    {"long": "host", "short": "H", "value": "", "usage": "API host (default: api.kuetix.com)"},
                    {"long": "config", "short": "c", "value": "", "usage": "Path to config file"},
                ]
            },
            "inspect": {
                "workflow": "cli/project/workflow",
                "usage": "file://cli/usage/inspect.txt",
                "options": [
                    {"long": "name", "short": "n", "value": "", "usage": "Workflow name or path"},
                    {"long": "source", "short": "S", "value": false, "usage": "Also print the full WSL source", "type": "bool"},
                    {"long": "json", "short": "j", "value": false, "usage": "Output as JSON", "type": "bool"},
                    {"long": "pretty", "short": "P", "value": false, "usage": "Pretty-print JSON output", "type": "bool"},
                ]
            },
            "status": {
                "workflow": "cli/workflow/status",
                "usage": "file://cli/usage/status.txt",
                "options": [
                    {"long": "no-check", "short": "N", "value": false, "usage": "Skip server comparison; list local only", "type": "bool"},
                    {"long": "host", "short": "H", "value": "", "usage": "API host (default: api.kuetix.com)"},
                    {"long": "config", "short": "c", "value": "", "usage": "Path to config file"},
                ]
            },
            "upload": {
                "workflow": "cli/workflow/upload_all",
                "usage": "file://cli/usage/upload.txt",
                "options": [
                    {"long": "name", "short": "n", "value": "", "usage": "Only upload local workflows matching this name or glob (default: all)"},
                    {"long": "output", "short": "o", "value": ".", "usage": "Project root containing workflows/"},
                    {"long": "method", "short": "M", "value": "POST", "usage": "HTTP method per workflow: POST or PUT"},
                    {"long": "projectName", "short": "p", "value": "", "usage": "Override project name (defaults to go.mod module, then project root)"},
                    {"long": "public", "short": "P", "value": false, "usage": "List in the public registry (default: private/personal)", "type": "bool"},
                    {"long": "host", "short": "H", "value": "", "usage": "API host (default: api.kuetix.com)"},
                    {"long": "config", "short": "c", "value": "", "usage": "Path to config file"},
                ]
            },
            "list": {
                "workflow": "cli/workflow/list",
                "usage": "file://cli/usage/list.txt",
                "options": [
                    {"long": "host", "short": "H", "value": "", "usage": "API host (default: api.kuetix.com)"},
                    {"long": "config", "short": "c", "value": "", "usage": "Path to config file"},
                ]
            },
            "delete": {
                "workflow": "cli/workflow/delete",
                "usage": "file://cli/usage/delete.txt",
                "options": [
                    {"long": "name", "short": "n", "value": "", "usage": "Workflow name"},
                    {"long": "host", "short": "H", "value": "", "usage": "API host (default: api.kuetix.com)"},
                    {"long": "config", "short": "c", "value": "", "usage": "Path to config file"},
                ]
            },
        },],

        // --- Registry workflow management (also `kue wsl <sub>`) -------------

        "get": [{
            "": {
                "workflow": "cli/install/install",
                "usage": "file://cli/usage/get.txt",
                "options": [
                    {"long": "name", "short": "n", "value": "", "usage": "Workflow (or package) name or glob"},
                    {"long": "type", "short": "t", "value": "", "usage": "Asset type: workflow or package (auto-detected if empty)"},
                    {"long": "owner", "short": "O", "value": "", "usage": "Registry owner id (disambiguates a workflow name)"},
                    {"long": "output", "short": "o", "value": ".", "usage": "Project directory (default: .)"},
                    {"long": "force", "short": "f", "value": false, "usage": "Overwrite local edits without prompting (get refreshes unchanged files anyway)", "type": "bool"},
                    {"long": "host", "short": "H", "value": "", "usage": "API host (default: api.kuetix.com)"},
                    {"long": "config", "short": "c", "value": "", "usage": "Path to config file"},
                ]
            },
            "*": {"$extends": ""},
            "help": {"$extends": "", "workflow": "cli/help"},
        },],

        "inspect": [{
            "": {
                "workflow": "cli/project/workflow",
                "usage": "file://cli/usage/inspect.txt",
                "options": [
                    {"long": "name", "short": "n", "value": "", "usage": "Workflow name or path"},
                    {"long": "source", "short": "S", "value": false, "usage": "Also print the full WSL source", "type": "bool"},
                    {"long": "json", "short": "j", "value": false, "usage": "Output as JSON", "type": "bool"},
                    {"long": "pretty", "short": "P", "value": false, "usage": "Pretty-print JSON output", "type": "bool"},
                ]
            },
            "*": {"$extends": ""},
            "help": {"$extends": "", "workflow": "cli/help"},
        },],

        "status": [{
            "": {
                "workflow": "cli/workflow/status",
                "usage": "file://cli/usage/status.txt",
                "options": [
                    {"long": "no-check", "short": "N", "value": false, "usage": "Skip server comparison; list local only", "type": "bool"},
                    {"long": "host", "short": "H", "value": "", "usage": "API host (default: api.kuetix.com)"},
                    {"long": "config", "short": "c", "value": "", "usage": "Path to config file"},
                ]
            },
            "help": {"$extends": "", "workflow": "cli/help"},
        },],

        "upload": [{
            "": {
                "workflow": "cli/workflow/upload_all",
                "usage": "file://cli/usage/upload.txt",
                "options": [
                    {"long": "name", "short": "n", "value": "", "usage": "Only upload local workflows matching this name or glob (default: all)"},
                    {"long": "output", "short": "o", "value": ".", "usage": "Project root containing workflows/"},
                    {"long": "method", "short": "M", "value": "POST", "usage": "HTTP method per workflow: POST or PUT"},
                    {"long": "projectName", "short": "p", "value": "", "usage": "Override project name (defaults to go.mod module, then project root)"},
                    {"long": "public", "short": "P", "value": false, "usage": "List in the public registry (default: private/personal)", "type": "bool"},
                    {"long": "host", "short": "H", "value": "", "usage": "API host (default: api.kuetix.com)"},
                    {"long": "config", "short": "c", "value": "", "usage": "Path to config file"},
                ]
            },
            "*": {"$extends": ""},
            "help": {"$extends": "", "workflow": "cli/help"},
        },],

